# Copie para .env (ignorado pelo git) e preencha. Valores são injetados no cluster
# como Secret do Kubernetes por `make secret`, nunca commitados.

# Opção A (assinatura Claude Pro/Max): gere com `claude setup-token` no seu terminal.
CLAUDE_CODE_OAUTH_TOKEN=

# Opção B (API paga com créditos): chave do console.anthropic.com
ANTHROPIC_API_KEY=
